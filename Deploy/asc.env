# App Store Connect: `op run --env-file Deploy/asc.env -- <command>` fills these
# from the "Cows In Love" vault of the personal 1Password account (the justfile's
# `asc` prefix does that). Nothing secret lives in the repo.
COWS_TEAM=op://Cows In Love/App Store Connect API/team id
COWS_ASC_KEY_ID=op://Cows In Love/App Store Connect API/key id
COWS_ASC_ISSUER_ID=op://Cows In Love/App Store Connect API/issuer id
COWS_ASC_KEY_P8=op://Cows In Love/App Store Connect API/private key
COWS_COPYRIGHT=op://Cows In Love/App Store Connect API/copyright
COWS_REVIEW_NAME=op://Cows In Love/App Store Connect API/review name
COWS_REVIEW_PHONE=op://Cows In Love/App Store Connect API/review phone
COWS_REVIEW_EMAIL=op://Cows In Love/App Store Connect API/review email
COWS_SUPPORT_URL=https://cowsinlove.com/support
COWS_PRIVACY_URL=https://cowsinlove.com/privacy
