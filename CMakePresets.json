{
    "version": 6,
    "configurePresets": [
        {
            "name": "android",
            "displayName": "Android arm64-v8a, API 33, Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-android-preset",
            "environment": {
                "COWS_NDK": "30.0.16248370"
            },
            "toolchainFile": "$env{HOME}/Library/Android/sdk/ndk/$env{COWS_NDK}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-33"
            }
        },
        {
            "name": "android-studio",
            "inherits": "android",
            "displayName": "Android Studio project in build-android-studio",
            "binaryDir": "${sourceDir}/build-android-studio/cmake",
            "cacheVariables": {
                "EACP_ANDROID_STUDIO_DIR": "${sourceDir}/build-android-studio"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "android",
            "configurePreset": "android",
            "targets": ["Cows-apk"]
        }
    ]
}
