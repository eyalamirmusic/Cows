{
    "version": 6,
    "configurePresets": [
        {
            "name": "android",
            "displayName": "Android arm64-v8a, API 30, Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-android",
            "toolchainFile": "${sourceDir}/CMake/AndroidToolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-30"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "android",
            "configurePreset": "android",
            "targets": ["Cows"]
        }
    ]
}
